{
  "name": "rescue-circular-logistics",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build:packages": "pnpm --filter @rescue/contracts build && pnpm --filter @rescue/database build",
    "dev": "pnpm build:packages && pnpm --parallel --filter @rescue/api --filter @rescue/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm build:packages && pnpm -r lint",
    "typecheck": "pnpm build:packages && pnpm --filter @rescue/api typecheck && pnpm --filter @rescue/web typecheck",
    "test": "pnpm build:packages && pnpm -r test",
    "test:e2e": "pnpm --filter @rescue/web build && pnpm --filter @rescue/web test:e2e",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @rescue/database generate",
    "db:migrate": "pnpm --filter @rescue/database migrate",
    "db:studio": "pnpm --filter @rescue/database studio",
    "db:deploy": "pnpm --filter @rescue/database exec prisma migrate deploy"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.19.0"
  }
}
