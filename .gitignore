coverage
# Every .env variant, not just two. `.env.production` holds an OIDC secret,
# a bucket credential and two keys that cannot be rotated -- and it was not
# covered until someone created one and noticed.
.env
.env.*
!.env.example
*.log
*.tsbuildinfo
.DS_Store
packages/database/prisma/dev.db

# The generated Prisma client. A build artefact of `prisma generate`, which
# runs as the database package's `prebuild`, so it is always present before
# anything imports it. `files` in that package.json re-includes it for the
# deploy, which is the one place this ignore rule would do damage.
packages/database/generated
test-results
playwright-report
blob-report
.playwright

# The Prometheus scrape token: a real credential, written by the operator.
deploy/prometheus/metrics-token
