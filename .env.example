NODE_ENV=development
API_PORT=4000
# Loopback by default. Set 0.0.0.0 only inside a container.
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Leave unset to run against the in-memory store (development only).
# Required in production.
# DATABASE_URL=
REDIS_URL=redis://localhost:6379

# Number of reverse proxies in front of the API. 0 disables X-Forwarded-For
# trust, which keeps rate limiting keyed on the real peer address. Raising this
# above the number of proxies you actually run lets clients spoof their IP.
TRUST_PROXY_HOPS=0

# Identity provider. Set BOTH in production; the development token endpoint at
# POST /v1/auth/dev-token disappears as soon as OIDC_ISSUER is present.
# OIDC_ISSUER=
# OIDC_JWKS_URI=
OIDC_AUDIENCE=rescue-api

# Signs development tokens only. Unset in development gives an ephemeral
# per-process secret. Generate with: openssl rand -base64 48
# Known placeholder values are rejected, including the one that used to be here.
# JWT_SECRET=

# Keys the vehicle-registration hash. Plates are never stored in plaintext.
# Required in production. Changing it orphans existing de-duplication hashes.
# REGISTRATION_HASH_KEY=

# How long a replayed Idempotency-Key keeps returning its stored response.
IDEMPOTENCY_TTL_HOURS=24

# Evidence storage. `mock` signs URLs but stores nothing, and is refused in
# production.
STORAGE_PROVIDER=mock
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=rescue-dev
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
EVIDENCE_UPLOAD_TTL_SECONDS=900

AI_PROVIDER=mock
# AI_API_KEY=
PAYMENT_PROVIDER=mock
# PAYMENT_SECRET_KEY=
MAPS_PROVIDER=mock
# MAPS_API_KEY=
