NODE_ENV=development
API_PORT=4000
# Loopback by default. Set 0.0.0.0 only inside a container.
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
DATABASE_URL=postgresql://rescue:rescue@localhost:5432/rescue
REDIS_URL=redis://localhost:6379
# Number of reverse proxies in front of the API. 0 disables X-Forwarded-For
# trust, which keeps rate limiting keyed on the real peer address. Raising this
# above the number of proxies you actually run lets clients spoof their IP.
TRUST_PROXY_HOPS=0
# Required in production; leave unset in development to get an ephemeral
# per-process secret. Generate with: openssl rand -base64 48
# The API rejects this line as written -- known placeholders are refused.
JWT_SECRET=
AI_PROVIDER=mock
AI_API_KEY=
PAYMENT_PROVIDER=mock
PAYMENT_SECRET_KEY=
MAPS_PROVIDER=mock
MAPS_API_KEY=
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=rescue-dev
S3_ACCESS_KEY=minio
S3_SECRET_KEY=miniosecret
