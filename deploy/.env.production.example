# Production environment for RESCUE.
#
# Copy to a secret store, fill it in, and check it before deploying:
#   node scripts/check-deploy-env.mjs .env.production
#
# Nothing here is optional theatre: the API refuses to boot without most of
# it, and the two that are only warnings are the two that fail silently.

NODE_ENV=production

# ------------------------------------------------------------- identity
# There is no password-less sign-in in production. Any OIDC provider works;
# the API verifies tokens against the JWKS and never issues its own.
OIDC_ISSUER=
OIDC_JWKS_URI=
OIDC_AUDIENCE=rescue-api

# --------------------------------------------------------------- secrets
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 48
# CHANGING THIS LATER IS NOT A ROTATION. It keys the vehicle-registration
# hashes, and a new value makes every stored hash permanently unmatchable.
REGISTRATION_HASH_KEY=
# openssl rand -hex 24
# Without it /metrics does not exist in production, so no alert can fire.
METRICS_TOKEN=

# -------------------------------------------------------------- database
# Most managed providers want sslmode=require.
DATABASE_URL=postgresql://user:password@host:5432/rescue?sslmode=require

# --------------------------------------------------------------- storage
# Evidence photographs. The mock is refused in production, and selecting s3
# without credentials is refused everywhere.
STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=eu-central-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Only for MinIO, R2, Backblaze and the like. Leave blank for AWS.
S3_ENDPOINT=
# Inferred from S3_ENDPOINT; set explicitly only if the gateway disagrees.
# S3_ADDRESSING=path
EVIDENCE_UPLOAD_TTL_SECONDS=900

# ---------------------------------------------------------------- origins
# https, or the session cookie will not survive.
WEB_ORIGIN=https://rescue.example
API_HOST=0.0.0.0
API_PORT=4000

# Read by the BROWSER, so it is baked into the web image at build time:
#   docker build --build-arg NEXT_PUBLIC_API_URL=https://api.rescue.example ...
# Setting it only at runtime leaves the browser calling localhost.
NEXT_PUBLIC_API_URL=https://api.rescue.example

# ----------------------------------------------------------------- proxy
# The number of proxies actually in front of the API. Too low and every
# client shares one rate-limit bucket; too high and a client can forge its
# own address and get a bucket to itself.
TRUST_PROXY_HOPS=1
RATE_LIMIT_MAX=300

# ------------------------------------------------------------------ maps
# Nominatim's policy requires a contactable agent; a generic one gets the
# deployment blocked rather than rate-limited.
MAPS_PROVIDER=osm
MAPS_USER_AGENT=RESCUE/1.0 (ops@rescue.example)

# ---------------------------------------------------------------- worker
WORKER_METRICS_PORT=4001
OUTBOX_POLL_MS=2000
SWEEP_INTERVAL_MS=60000

# -------------------------------------------------------------- retention
# Days. See docs/audits/DATA_INVENTORY.md for the basis of each; a controller
# has to accept or change them.
RETENTION_EVIDENCE_DAYS=365
RETENTION_OUTBOX_SENT_DAYS=30
RETENTION_IDEMPOTENCY_DAYS=7
